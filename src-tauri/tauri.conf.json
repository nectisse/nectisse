{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Nectisse",
	"version": "0.2.0",
	"identifier": "app.nectisse.desktop",
	"build": {
		"beforeDevCommand": "npm run dev:web",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "Nectisse",
				"width": 1280,
				"height": 840,
				"minWidth": 1000,
				"minHeight": 700,
				"center": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 18,
					"y": 22
				},
				"backgroundColor": "#faf9f6",
				"create": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: nectisse-cover: http://nectisse-cover.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
			"devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: nectisse-cover: http://nectisse-cover.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'",
			"capabilities": [
				{
					"identifier": "main-window",
					"windows": ["main"],
					"permissions": ["core:event:default", "core:window:allow-start-dragging", "core:window:allow-toggle-maximize"]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"category": "Productivity",
		"shortDescription": "A private collection and creator updates workspace",
		"icon": ["../resources/icons/icon.icns"],
		"resources": {
			"../.build/python/darwin-arm64/runtime/": "python/runtime/",
			"../.build/python/darwin-arm64/dependencies/": "python/dependencies/",
			"../.build/python/darwin-arm64/manifest.json": "python/manifest.json",
			"../python/bootstrap.py": "python/app/bootstrap.py",
			"../python/src/": "python/app/src/",
			"../python/vendor/": "python/app/vendor/",
			"../resources/notices/": "third-party/",
			"../resources/licenses/": "legal/resources/licenses/",
			"../.github/SOURCE.md": "legal/.github/SOURCE.md",
			"../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md"
		},
		"macOS": {
			"minimumSystemVersion": "13.3",
			"signingIdentity": "-",
			"hardenedRuntime": true,
			"entitlements": "Entitlements.plist"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNjQwRTZFQTAyRTZDMTIKUldRU2JDNmdiZzVrUS9RQWM0TG1rcEliWm4xZ29xQ2YyRjB0Y3pFRmlod2NXbzEvQmNsbmVZVHAK",
			"endpoints": ["https://github.com/nectisse/nectisse/releases/latest/download/latest.json"],
			"requireSignedVersion": true,
			"allowDowngrades": false
		}
	}
}
