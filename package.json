{
	"name": "nectisse",
	"productName": "Nectisse",
	"version": "0.2.0",
	"private": true,
	"description": "私人作品资料与创作者更新桌面应用",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "npm run python:prepare && tauri dev",
		"dev:web": "vite --host 127.0.0.1",
		"tauri": "tauri",
		"python:prepare": "node scripts/prepare-python.mjs",
		"icons:build": "npm run python:prepare && node scripts/build-icons.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.web.json",
		"build": "npm run contracts:generate && npm run typecheck && vite build",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:python": "node scripts/test-python.mjs",
		"test:native": "npm run build && node scripts/native-e2e.mjs",
		"check": "npm run typecheck && node scripts/check-architecture.mjs && npm test && npm run test:rust",
		"package:app": "npm run icons:build && tauri build --bundles app",
		"package:mac": "npm run package:app",
		"package:dmg": "npm run icons:build && tauri build --bundles app,dmg",
		"release:mac": "npm run icons:build && node scripts/release-macos.mjs",
		"release:mac:preview": "npm run icons:build && node scripts/release-macos.mjs --unsigned",
		"release:verify": "node scripts/verify-release.mjs",
		"format:check": "prettier --check src/renderer/shared/desktop/tauri-bridge.ts src-tauri/tauri.conf.json scripts/*release*.mjs scripts/*sign*.mjs scripts/native* scripts/verify-package.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
		"test:native:release": "npm run build && node scripts/native-e2e.mjs --release",
		"licenses:generate": "node scripts/third-party-notices.mjs",
		"licenses:check": "node scripts/third-party-notices.mjs --check",
		"contracts:generate": "node --import tsx scripts/generate-contracts.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@tanstack/react-query": "5.104.5",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"lucide-react": "1.61.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"zod": "4.6.7",
		"zustand": "5.0.16",
		"@tauri-apps/api": "2.12.4"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"dependency-cruiser": "18.7.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"@tauri-apps/cli": "2.12.4",
		"prettier": "3.9.10",
		"@swc/core": "1.16.20"
	}
}
